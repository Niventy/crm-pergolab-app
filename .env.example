# ----------------------------------------------------------------------------
# CRM Pergolab — variables d'environnement
# Copier ce fichier en `.env.local` et remplir les valeurs.
# NE JAMAIS committer `.env.local` ni de vraie clé.
# ----------------------------------------------------------------------------

# --- Supabase (client navigateur) ------------------------------------------
# Dashboard Supabase > Project Settings > Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGci...."

# --- Supabase (serveur uniquement, NE PAS exposer au client) ----------------
# Dashboard Supabase > Project Settings > API Keys > service_role
# Sert aux opérations serveur (webhook entrant) qui contournent la RLS.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci...."

# --- Base de données (Drizzle migrations / seed) ----------------------------
# Dashboard Supabase > Project Settings > Database > Connection string
# Utiliser la connexion "Session"/"Direct" (port 5432) pour les migrations.
# Le mot de passe est celui défini à la création du projet Supabase.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxxxxxx.supabase.co:5432/postgres"

# --- Webhook entrant (Meta Lead Ads via Zapier / Make) ----------------------
# Secret partagé attendu dans l'en-tête: Authorization: Bearer <SECRET>
# Générer une valeur aléatoire longue, ex: openssl rand -hex 32
INBOUND_WEBHOOK_SECRET="changez-moi-par-une-valeur-aleatoire-longue"

# --- Envoi d'emails via Gmail (OAuth) ---------------------------------------
# Le CRM envoie depuis un compte d'envoi @pergolab.fr autorisé via OAuth.
# Mise en place (droits "Propriétaire de projet" suffisent) :
#   1) console.cloud.google.com > projet > activer "Gmail API".
#   2) APIs & services > Écran de consentement OAuth : User type = Interne.
#   3) Identifiants > Créer un ID client OAuth (type "Application Web"),
#      Redirect URI = https://developers.google.com/oauthplayground
#   4) developers.google.com/oauthplayground > roue crantée > "Use your own
#      OAuth credentials" (colle client id + secret) > scope
#      https://www.googleapis.com/auth/gmail.send > Authorize (compte adv@) >
#      Exchange > copie le "refresh token".
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxx"
GOOGLE_REFRESH_TOKEN="1//xxxxx"
# Adresse d'expédition (le compte qui a autorisé). From affiché aux destinataires.
GOOGLE_SENDER="Pergolab <adv@pergolab.fr>"
